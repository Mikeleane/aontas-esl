"use client";

import React, { useCallback, useEffect, useMemo, useRef, useState } from "react";
import { buildWordinessSeedFromText } from "../wordiness/buildWordinessSeed";

// Re-export types so other files can import from here if you like.
export type ReadingPackVariant = "standard" | "SUPPORTED";

type ExercisePromptBlock = {
  prompt?: string;
  options?: string[];
};

export type ExerciseItem = {
  id: number;
  type: string;
  skill?: string;
  standard?: ExercisePromptBlock;
  SUPPORTED?: ExercisePromptBlock;
  adapted?: ExercisePromptBlock; // back-compat
  prompt?: string; // back-compat
  answer?: string | string[] | number | boolean | null;
  explanation?: string;
};

export type ReadingPack = {
  // Reading text fields (different Aontas variants have used different names over time)
  standardText?: string;
  supportedText?: string;
  SUPPORTEDText?: string;
  standard?: string;
  SUPPORTED?: string;
  text?: string;
  primaryText?: string;
  articleText?: string;
  passage?: string;
  content?: string;

  title?: string;
  topic?: string;
  cefrLevel?: string;
  level?: string;
  textType?: string;

  // Exercises
  exercises?: ExerciseItem[];

  // Anything else
  [k: string]: any;
};

const BRAND = {
  ink: "#0f172a",
  muted: "#475569",
  muted2: "#64748b",
  card: "rgba(255,255,255,.78)",
  border: "rgba(15,23,42,.12)",
  border2: "rgba(15,23,42,.16)",
  soft: "rgba(248,250,252,.65)",
};

function isNonEmptyString(x: any): x is string {
  return typeof x === "string" && x.trim().length > 0;
}

function safeJoin(...parts: Array<string | undefined | null>) {
  return parts.filter(Boolean).join("");
}

function extractReadingText(pack: ReadingPack | null, variant: ReadingPackVariant): string {
  if (!pack) return "";
  const pick = (v: any) => (typeof v === "string" ? v : "");

  // Normalize variant
  const src = variant === "SUPPORTED" ? "SUPPORTED" : "standard";

  // Try the most likely fields across Aontas variants
  const textForSeed =
    pick(pack[`${src}Text`]) ||
    pick(pack[`${src.toLowerCase()}Text`]) ||
    pick(pack[src]) ||
    pick(pack.text) ||
    pick(pack.primaryText) ||
    pick(pack.articleText) ||
    pick(pack.passage) ||
    pick(pack.content) ||
    "";

  return textForSeed;
}

function getExercises(pack: ReadingPack | null): ExerciseItem[] {
  const ex = pack?.exercises;
  if (!Array.isArray(ex)) return [];
  // Filter out empty items safely (explicit any avoided by typing above)
  return ex.filter((item) => {
    const p = item?.prompt ?? item?.standard?.prompt ?? item?.SUPPORTED?.prompt ?? item?.adapted?.prompt;
    return isNonEmptyString(p);
  });
}

function prettyLabel(x?: string) {
  if (!x) return "";
  return x
    .replace(/_/g, " ")
    .replace(/\s+/g, " ")
    .trim()
    .replace(/\b\w/g, (c) => c.toUpperCase());
}

function splitParas(text: string): string[] {
  const t = (text || "").replace(/\r/g, "");
  const blocks = t.split(/\n{2,}/g).map((s) => s.trim()).filter(Boolean);
  return blocks.length ? blocks : t.split(/\n/g).map((s) => s.trim()).filter(Boolean);
}

export default function ReadingPackApp() {
  const [pack, setPack] = useState<ReadingPack | null>(null);
  const [mode, setMode] = useState<ReadingPackVariant>("standard");

  const [busy, setBusy] = useState<"" | "generate" | "exercises">("");
  const [error, setError] = useState<string>("");

  // Inputs
  const [cefrLevel, setCefrLevel] = useState<string>("B1");
  const [textType, setTextType] = useState<string>("article");
  const [topic, setTopic] = useState<string>("School phone policy");
  const [sourceText, setSourceText] = useState<string>("");

  // Abort support
  const abortRef = useRef<AbortController | null>(null);

  const readingText = useMemo(() => extractReadingText(pack, mode), [pack, mode]);

  const packSummary = useMemo(() => {
    const lvl = pack?.cefrLevel ?? pack?.level ?? cefrLevel;
    const tt = pack?.textType ?? textType;
    const t = pack?.topic ?? topic;
    const bits = [
      lvl ? `CEFR ${lvl}` : "",
      tt ? prettyLabel(tt) : "",
      t ? `Topic: ${t}` : "",
      "STANDARD + SUPPORTED share one answer key.",
    ].filter(Boolean);
    return bits.join(" • ");
  }, [pack, cefrLevel, textType, topic]);

  // Wordiness seed derived from the reading text
  useEffect(() => {
    try {
      const textForSeed = extractReadingText(pack, mode);
      if (!isNonEmptyString(textForSeed)) return;

      const seed = buildWordinessSeedFromText(textForSeed, "reading-pack");
      localStorage.setItem("wordiness_seed_json", JSON.stringify(seed));
    } catch {
      // ignore
    }
  }, [pack, mode]);

  const postJson = useCallback(async (url: string, body: any, signal?: AbortSignal) => {
    const res = await fetch(url, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(body),
      signal,
    });
    if (!res.ok) {
      const t = await res.text().catch(() => "");
      throw new Error(`HTTP ${res.status}: ${t || res.statusText}`);
    }
    return res.json();
  }, []);

  const onGeneratePack = useCallback(async () => {
    setError("");
    setBusy("generate");
    abortRef.current?.abort();
    abortRef.current = new AbortController();

    try {
      const body = {
        cefrLevel,
        level: cefrLevel, // back-compat
        textType,
        topic,
        sourceText: sourceText.trim() ? sourceText : undefined,
      };

      // This route should return a pack with reading text + (optionally) exercises.
      const data = (await postJson("/api/reading/generate-pack", body, abortRef.current.signal)) as ReadingPack;
      setPack(data);
    } catch (e: any) {
      setError(e?.message ?? String(e));
    } finally {
      setBusy("");
    }
  }, [cefrLevel, textType, topic, sourceText, postJson]);

  const onGenerateExercisesOnly = useCallback(async () => {
    setError("");
    setBusy("exercises");
    abortRef.current?.abort();
    abortRef.current = new AbortController();

    try {
      const baseText = sourceText.trim() || extractReadingText(pack, "standard") || extractReadingText(pack, "SUPPORTED");
      if (!isNonEmptyString(baseText)) {
        throw new Error(
          "No source text found. Either paste Source text, or click 'Generate reading pack' first so we have a passage to build exercises from."
        );
      }

      const body = {
        cefrLevel,
        level: cefrLevel, // back-compat
        text: baseText,
      };

      const data = await postJson("/api/exercises", body, abortRef.current.signal);

      // Merge exercises onto current pack so reading text stays visible.
      setPack((prev) => ({
        ...(prev ?? {}),
        exercises: Array.isArray((data as any)?.items) ? (data as any).items : (data as any)?.exercises ?? [],
      }));
    } catch (e: any) {
      setError(e?.message ?? String(e));
    } finally {
      setBusy("");
    }
  }, [cefrLevel, sourceText, pack, postJson]);

  const exercises = useMemo(() => getExercises(pack), [pack]);

  const activeBlock = (item: ExerciseItem): ExercisePromptBlock => {
    if (mode === "standard") return item.standard ?? { prompt: item.prompt };
    return item.SUPPORTED ?? item.adapted ?? item.standard ?? { prompt: item.prompt };
  };

  return (
    <div style={{ padding: 18, maxWidth: 1200, margin: "0 auto" }}>
      <div
        style={{
          background: BRAND.card,
          border: `1px solid ${BRAND.border}`,
          borderRadius: 18,
          padding: 18,
          boxShadow: "0 10px 30px rgba(15,23,42,.06)",
        }}
      >
        <div style={{ display: "flex", gap: 14, alignItems: "center", justifyContent: "space-between", flexWrap: "wrap" }}>
          <div>
            <div style={{ fontWeight: 1100, fontSize: 22, color: BRAND.ink }}>Reading Pack</div>
            <div style={{ color: BRAND.muted, marginTop: 6, fontSize: 13 }}>{packSummary}</div>
            <div style={{ color: BRAND.muted2, marginTop: 6, fontSize: 12, lineHeight: 1.4 }}>
              Interactive export is separate. Printables export as HTML (quick print), PDF, or DOCX.
            </div>
          </div>

          <div style={{ display: "flex", gap: 10, alignItems: "center", flexWrap: "wrap" }}>
            <div style={{ fontSize: 12, fontWeight: 900, color: BRAND.muted2 }}>View</div>
            <select
              value={mode}
              onChange={(e) => setMode(e.target.value as ReadingPackVariant)}
              style={{
                padding: "8px 10px",
                borderRadius: 12,
                border: `1px solid ${BRAND.border2}`,
                background: "white",
                fontWeight: 800,
              }}
            >
              <option value="standard">STANDARD</option>
              <option value="SUPPORTED">SUPPORTED</option>
            </select>
          </div>
        </div>

        {error ? (
          <div
            style={{
              marginTop: 14,
              padding: 12,
              borderRadius: 14,
              background: "rgba(239,68,68,.10)",
              border: "1px solid rgba(239,68,68,.30)",
              color: "#7f1d1d",
              fontWeight: 800,
              whiteSpace: "pre-wrap",
            }}
          >
            {error}
          </div>
        ) : null}

        <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: 14, marginTop: 18 }}>
          <div
            style={{
              border: `1px solid ${BRAND.border}`,
              borderRadius: 18,
              padding: 14,
              background: BRAND.soft,
            }}
          >
            <div style={{ fontWeight: 1000, marginBottom: 10, color: BRAND.ink }}>Inputs</div>

            <div style={{ display: "grid", gridTemplateColumns: "120px 1fr", gap: 10, alignItems: "center" }}>
              <div style={{ fontWeight: 900, color: BRAND.muted2, fontSize: 12 }}>CEFR</div>
              <select
                value={cefrLevel}
                onChange={(e) => setCefrLevel(e.target.value)}
                style={{ padding: "8px 10px", borderRadius: 12, border: `1px solid ${BRAND.border2}`, background: "white", fontWeight: 800 }}
              >
                {["A2", "B1", "B2", "C1", "C2"].map((L) => (
                  <option key={L} value={L}>
                    {L}
                  </option>
                ))}
              </select>

              <div style={{ fontWeight: 900, color: BRAND.muted2, fontSize: 12 }}>Text type</div>
              <select
                value={textType}
                onChange={(e) => setTextType(e.target.value)}
                style={{ padding: "8px 10px", borderRadius: 12, border: `1px solid ${BRAND.border2}`, background: "white", fontWeight: 800 }}
              >
                {["story", "short_message", "email_informal", "email_formal", "article", "review", "report", "essay"].map((t) => (
                  <option key={t} value={t}>
                    {prettyLabel(t)}
                  </option>
                ))}
              </select>

              <div style={{ fontWeight: 900, color: BRAND.muted2, fontSize: 12 }}>Topic</div>
              <input
                value={topic}
                onChange={(e) => setTopic(e.target.value)}
                placeholder="e.g., School phone policy"
                style={{ padding: "10px 12px", borderRadius: 12, border: `1px solid ${BRAND.border2}`, background: "white", fontWeight: 700 }}
              />

              <div style={{ fontWeight: 900, color: BRAND.muted2, fontSize: 12, alignSelf: "start", paddingTop: 8 }}>Source text</div>
              <textarea
                value={sourceText}
                onChange={(e) => setSourceText(e.target.value)}
                placeholder="Optional: paste a source text here. Leave empty to generate from Topic."
                rows={7}
                style={{
                  padding: "10px 12px",
                  borderRadius: 12,
                  border: `1px solid ${BRAND.border2}`,
                  background: "white",
                  fontWeight: 650,
                  lineHeight: 1.4,
                  resize: "vertical",
                }}
              />
            </div>

            <div style={{ display: "flex", gap: 10, marginTop: 12, flexWrap: "wrap" }}>
              <button
                onClick={onGeneratePack}
                disabled={busy !== ""}
                style={{
                  padding: "10px 12px",
                  borderRadius: 14,
                  border: `1px solid ${BRAND.border2}`,
                  background: busy === "generate" ? "rgba(15,23,42,.08)" : "white",
                  fontWeight: 1000,
                  cursor: busy === "" ? "pointer" : "not-allowed",
                }}
              >
                {busy === "generate" ? "Generating..." : "Generate reading pack"}
              </button>

              <button
                onClick={onGenerateExercisesOnly}
                disabled={busy !== ""}
                style={{
                  padding: "10px 12px",
                  borderRadius: 14,
                  border: `1px solid ${BRAND.border2}`,
                  background: busy === "exercises" ? "rgba(15,23,42,.08)" : "white",
                  fontWeight: 1000,
                  cursor: busy === "" ? "pointer" : "not-allowed",
                }}
              >
                {busy === "exercises" ? "Generating..." : "Generate exercises"}
              </button>

              <button
                onClick={() => abortRef.current?.abort()}
                disabled={busy === ""}
                style={{
                  padding: "10px 12px",
                  borderRadius: 14,
                  border: `1px solid ${BRAND.border2}`,
                  background: busy === "" ? "rgba(15,23,42,.05)" : "white",
                  fontWeight: 1000,
                  cursor: busy === "" ? "not-allowed" : "pointer",
                }}
              >
                Cancel
              </button>
            </div>
          </div>

          <div
            style={{
              border: `1px solid ${BRAND.border}`,
              borderRadius: 18,
              padding: 14,
              background: "white",
            }}
          >
            <div style={{ fontWeight: 1000, marginBottom: 10, color: BRAND.ink }}>Reading text ({mode})</div>

            {!isNonEmptyString(readingText) ? (
              <div style={{ color: BRAND.muted2, fontWeight: 750, fontSize: 13, lineHeight: 1.4 }}>
                No reading text yet. Either:
                <ul style={{ marginTop: 10 }}>
                  <li>Click <b>Generate reading pack</b> (it returns the passage), or</li>
                  <li>Paste a <b>Source text</b> and then generate exercises.</li>
                </ul>
              </div>
            ) : (
              <div
                style={{
                  border: `1px solid ${BRAND.border}`,
                  borderRadius: 14,
                  padding: 12,
                  background: BRAND.soft,
                  maxHeight: 340,
                  overflow: "auto",
                }}
              >
                {splitParas(readingText).map((p, i) => (
                  <p key={i} style={{ margin: "0 0 10px 0", color: BRAND.ink, lineHeight: 1.55, fontWeight: 650 }}>
                    {p}
                  </p>
                ))}
              </div>
            )}
          </div>
        </div>
      </div>

      <div style={{ marginTop: 18 }}>
        <div style={{ fontWeight: 1100, fontSize: 18, color: BRAND.ink, marginBottom: 10 }}>Exercises</div>

        {!exercises.length ? (
          <div style={{ color: BRAND.muted2, fontWeight: 750, fontSize: 13 }}>
            No exercises yet. Click <b>Generate exercises</b>.
          </div>
        ) : (
          <div style={{ display: "grid", gridTemplateColumns: "1fr", gap: 12 }}>
            {exercises.map((ex) => {
              const block = activeBlock(ex);
              const prompt = block?.prompt ?? "";
              const opts = Array.isArray(block?.options) ? block!.options! : [];

              return (
                <div
                  key={ex.id}
                  style={{
                    borderRadius: 18,
                    border: `1px solid ${BRAND.border}`,
                    background: "white",
                    padding: 14,
                    boxShadow: "0 8px 20px rgba(15,23,42,.06)",
                  }}
                >
                  <div style={{ display: "flex", gap: 10, alignItems: "baseline", flexWrap: "wrap" }}>
                    <span
                      style={{
                        fontSize: 12,
                        fontWeight: 1000,
                        padding: "4px 8px",
                        borderRadius: 999,
                        background: "rgba(15,23,42,.06)",
                        color: BRAND.ink,
                      }}
                    >
                      {ex.type}
                    </span>
                    {ex.skill ? (
                      <span style={{ fontSize: 12, fontWeight: 900, color: BRAND.muted2 }}>{prettyLabel(ex.skill)}</span>
                    ) : null}
                    <span style={{ fontSize: 12, fontWeight: 900, color: BRAND.muted2 }}>#{ex.id}</span>
                  </div>

                  <div style={{ marginTop: 10, color: BRAND.ink, fontWeight: 850, lineHeight: 1.4, whiteSpace: "pre-wrap" }}>
                    {prompt}
                  </div>

                  {opts.length ? (
                    <ul style={{ marginTop: 10, marginBottom: 0, paddingLeft: 18 }}>
                      {opts.map((o, i) => (
                        <li key={i} style={{ margin: "6px 0", color: BRAND.ink, fontWeight: 700, lineHeight: 1.35 }}>
                          {o}
                        </li>
                      ))}
                    </ul>
                  ) : null}

                  {ex.answer !== undefined ? (
                    <div style={{ marginTop: 12, fontSize: 13, color: BRAND.muted, fontWeight: 900 }}>
                      Answer:{" "}
                      <span style={{ color: BRAND.ink, fontWeight: 1000 }}>
                        {Array.isArray(ex.answer) ? ex.answer.join(", ") : String(ex.answer)}
                      </span>
                    </div>
                  ) : null}

                  {ex.explanation ? (
                    <div style={{ marginTop: 10, fontSize: 13, color: BRAND.muted, lineHeight: 1.4, fontWeight: 750 }}>
                      {ex.explanation}
                    </div>
                  ) : null}
                </div>
              );
            })}
          </div>
        )}
      </div>

      <div style={{ height: 40 }} />
    </div>
  );
}
