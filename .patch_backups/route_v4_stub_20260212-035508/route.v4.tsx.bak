import { NextResponse } from "next/server";
import OpenAI from "openai";

export const runtime = "nodejs";

/**
 * /api/reading/generate-pack
 *
 * Goal: return { pack: ReadingPackData }.
 * This version intentionally avoids strict JSON Schema enforcement (which has been tripping Turbopack + API params),
 * and instead requests a JSON object and validates it server-side.
 */

type CefrLevel = "A1" | "A2" | "B1" | "B2" | "C1" | "C2";

type VariantKey = "standard" | "SUPPORTED";

type ExerciseType =
  | "mcq"
  | "true_false"
  | "short_answer"
  | "matching"
  | "gap_fill"
  | "sequencing"
  | "vocab";

type ExerciseVariant = {
  prompt: string;
  options?: string[];
  supports?: string[];
};

type ExerciseItem = {
  id: string;
  type: ExerciseType;
  answer: string;
  standard: ExerciseVariant;
  SUPPORTED: ExerciseVariant;
};

export type ReadingPackData = {
  title: string;
  stage: number;
  schoolClass: number;
  cefrLevel?: string;
  reading: {
    standard: string;
    SUPPORTED: string;
  };
  exercises: ExerciseItem[];
};

type Incoming = any;

function isNonEmptyString(x: unknown): x is string {
  return typeof x === "string" && x.trim().length > 0;
}

function safeNumber(x: any): number | undefined {
  const n = Number(x);
  return Number.isFinite(n) ? n : undefined;
}

function parseCefr(x: any): CefrLevel {
  const s = String(x ?? "").toUpperCase().trim();
  if (s === "A1" || s === "A2" || s === "B1" || s === "B2" || s === "C1" || s === "C2") return s;
  return "B1";
}

function cefrToStageBand(level: CefrLevel): number {
  // ESL-friendly mapping: B1 ~ stage 3, B2+ ~ stage 4
  if (level === "A1") return 1;
  if (level === "A2") return 2;
  if (level === "B1") return 3;
  return 4;
}

function stageTargets(stage: number) {
  if (stage <= 1) return { min: 120, max: 220 };
  if (stage === 2) return { min: 220, max: 360 };
  if (stage === 3) return { min: 360, max: 600 };
  return { min: 650, max: 950 };
}

function normalizeInput(body: Incoming) {
  const meta = (body?.meta ?? {}) as any;
  const material = (body?.material ?? {}) as any;
  const alignment = (body?.alignment ?? {}) as any;

  const cefrLevel = parseCefr(meta?.cefrLevel ?? body?.cefrLevel ?? body?.level ?? "B1");
  const stageFromMeta = safeNumber(meta?.stage ?? body?.stage);
  const stage = stageFromMeta ?? cefrToStageBand(cefrLevel);

  const schoolClassFromMeta = safeNumber(meta?.schoolClass ?? meta?.class ?? body?.schoolClass ?? body?.class);
  const schoolClass = schoolClassFromMeta ?? stage;

  const titleHint = isNonEmptyString(meta?.titleHint ?? body?.titleHint) ? String(meta?.titleHint ?? body?.titleHint).trim() : "";

  const textType = String(alignment?.textType ?? "").trim();
  const supports = Array.isArray(alignment?.supports) ? alignment.supports.map(String) : [];
  const purpose = Array.isArray(alignment?.purpose) ? alignment.purpose.map(String) : [];
  const teacherNotes = String(alignment?.notes ?? body?.teacherNotes ?? "").trim();

  const pilotMode = !!(body?.pilotMode ?? body?.options?.pilotMode);
  const allowLocalRefs = !!(body?.allowLocalRefs ?? body?.options?.allowLocalRefs);

  // material can come as {kind:"text", text:"..."} OR legacy fields
  const kind = String(material?.kind ?? "text");
  const text =
    isNonEmptyString(material?.text)
      ? String(material.text)
      : isNonEmptyString(body?.text)
        ? String(body.text)
        : "";
  const html = isNonEmptyString(material?.html) ? String(material.html) : "";
  const url = isNonEmptyString(material?.url) ? String(material.url) : "";

  return {
    cefrLevel,
    stage,
    schoolClass,
    titleHint,
    textType,
    supports,
    purpose,
    teacherNotes,
    pilotMode,
    allowLocalRefs,
    material: { kind, text, html, url },
  };
}

function getInputText(n: ReturnType<typeof normalizeInput>): { inputText: string; sourceLabel: string } | null {
  if (isNonEmptyString(n.material.text)) return { inputText: n.material.text.trim(), sourceLabel: "TEXT" };
  if (isNonEmptyString(n.material.html)) return { inputText: n.material.html.trim(), sourceLabel: "HTML" };
  if (isNonEmptyString(n.material.url)) return { inputText: n.material.url.trim(), sourceLabel: "URL" };
  return null;
}

function buildSystemPrompt(n: ReturnType<typeof normalizeInput>) {
  const t = stageTargets(n.stage);
  return [
    "You are an expert teacher creating an ESL Reading Pack.",
    "You MUST output a single JSON object and nothing else.",
    "Create TWO variants: standard and SUPPORTED.",
    "SUPPORTED must NOT be oversimplified: keep the same learning target and the SAME answer key.",
    "All exercise items share ONE answer field used by both variants.",
    `Target reading length (stage ${n.stage}): STANDARD about ${t.min}-${t.max} words. SUPPORTED should be similar length with access supports (spacing, simpler phrasing, glosses), not a tiny summary.`,
    n.pilotMode ? "PILOT MODE: keep source notes brief and copyright-safe; do not reproduce copyrighted text." : "",
  ]
    .filter(Boolean)
    .join("\n");
}

function buildUserPrompt(n: ReturnType<typeof normalizeInput>, inputText: string, sourceLabel: string) {
  const local = n.allowLocalRefs ? "You may include local names/places if helpful." : "Avoid local names/places unless present in the input.";

  const schemaHint = {
    title: "(string)",
    stage: n.stage,
    schoolClass: n.schoolClass,
    cefrLevel: n.cefrLevel,
    reading: {
      standard: "(string)",
      SUPPORTED: "(string)",
    },
    exercises: [
      {
        id: "ex1",
        type: "mcq | true_false | short_answer | matching | gap_fill | sequencing | vocab",
        answer: "(string, shared answer key)",
        standard: { prompt: "(string)", options: ["(optional)"] },
        SUPPORTED: { prompt: "(string)", options: ["(optional)", "..."], supports: ["(optional access supports)"] },
      },
    ],
  };

  return [
    `CEFR: ${n.cefrLevel}. Class: ${n.schoolClass}. Stage band: ${n.stage}.`,
    n.titleHint ? `Title hint: ${n.titleHint}` : "",
    n.textType ? `Text type preference: ${n.textType}` : "",
    n.purpose.length ? `Purposes: ${n.purpose.join(", ")}` : "",
    n.supports.length ? `Requested supports: ${n.supports.join(", ")}` : "",
    n.teacherNotes ? `Teacher notes: ${n.teacherNotes}` : "",
    local,
    "\nTASK:\n1) Write a coherent reading text for STANDARD and a SUPPORTED version.\n2) Create 10 exercises based ONLY on the reading.\n3) Ensure SUPPORTED uses access supports (clearer layout cues, smaller steps, glosses, sentence starters) but keeps the SAME answers.",
    "\nOUTPUT:\nReturn ONE JSON object matching this shape (example types shown):\n" + JSON.stringify(schemaHint, null, 2),
    `\nINPUT (${sourceLabel}):\n"""\n${inputText}\n"""`,
  ]
    .filter(Boolean)
    .join("\n");
}

function coercePack(raw: any, fallback: ReturnType<typeof normalizeInput>): ReadingPackData {
  const title = isNonEmptyString(raw?.title) ? String(raw.title).trim() : fallback.titleHint || "Reading Pack";
  const stage = safeNumber(raw?.stage) ?? fallback.stage;
  const schoolClass = safeNumber(raw?.schoolClass) ?? fallback.schoolClass;
  const cefrLevel = isNonEmptyString(raw?.cefrLevel) ? String(raw.cefrLevel).trim() : fallback.cefrLevel;

  const readingStd = isNonEmptyString(raw?.reading?.standard) ? String(raw.reading.standard).trim() : "";
  const readingSup = isNonEmptyString(raw?.reading?.SUPPORTED) ? String(raw.reading.SUPPORTED).trim() : "";

  const exercisesIn = Array.isArray(raw?.exercises) ? raw.exercises : [];
  const exercises: ExerciseItem[] = exercisesIn
    .slice(0, 20)
    .map((ex: any, idx: number) => {
      const id = isNonEmptyString(ex?.id) ? String(ex.id).trim() : `ex${idx + 1}`;
      const typeRaw = String(ex?.type ?? "short_answer").trim();
      const type: ExerciseType = (
        ["mcq", "true_false", "short_answer", "matching", "gap_fill", "sequencing", "vocab"].includes(typeRaw)
          ? typeRaw
          : "short_answer"
      ) as ExerciseType;
      const answer = isNonEmptyString(ex?.answer) ? String(ex.answer).trim() : "";

      const stdPrompt = isNonEmptyString(ex?.standard?.prompt) ? String(ex.standard.prompt).trim() : "";
      const supPrompt = isNonEmptyString(ex?.SUPPORTED?.prompt) ? String(ex.SUPPORTED.prompt).trim() : stdPrompt;

      const stdOpts = Array.isArray(ex?.standard?.options) ? ex.standard.options.map(String) : undefined;
      const supOpts = Array.isArray(ex?.SUPPORTED?.options) ? ex.SUPPORTED.options.map(String) : stdOpts;

      const supSupports = Array.isArray(ex?.SUPPORTED?.supports) ? ex.SUPPORTED.supports.map(String) : undefined;

      return {
        id,
        type,
        answer,
        standard: {
          prompt: stdPrompt,
          options: stdOpts,
        },
        SUPPORTED: {
          prompt: supPrompt,
          options: supOpts,
          supports: supSupports,
        },
      };
    })
    .filter((ex) => isNonEmptyString(ex.prompt ?? ex.standard?.prompt));

  if (!isNonEmptyString(readingStd) || !isNonEmptyString(readingSup)) {
    throw new Error("Model output missing reading text.");
  }

  if (exercises.length < 6) {
    throw new Error("Model output missing exercises.");
  }

  return {
    title,
    stage,
    schoolClass,
    cefrLevel,
    reading: { standard: readingStd, SUPPORTED: readingSup },
    exercises,
  };
}

export async function POST(req: Request) {
  try {
    const body = (await req.json().catch(() => null)) as Incoming;
    if (!body) return NextResponse.json({ error: "Invalid JSON body." }, { status: 400 });

    const n = normalizeInput(body);
    const input = getInputText(n);

    if (!input) {
      return NextResponse.json({ error: "Missing input text (material.text/url/html)." }, { status: 400 });
    }

    const apiKey = process.env.OPENAI_API_KEY;
    if (!apiKey) return NextResponse.json({ error: "Missing OPENAI_API_KEY." }, { status: 500 });

    const model = process.env.OPENAI_MODEL || "gpt-4.1-mini";

    const client = new OpenAI({ apiKey });

    const systemPrompt = buildSystemPrompt(n);
    const userPrompt = buildUserPrompt(n, input.inputText, input.sourceLabel);

    // Use Chat Completions w/ json_object to avoid fragile json_schema issues.
    const completion = await client.chat.completions.create({
      model,
      temperature: 0.3,
      response_format: { type: "json_object" },
      messages: [
        { role: "system", content: systemPrompt },
        { role: "user", content: userPrompt },
      ],
    });

    const text = completion.choices?.[0]?.message?.content ?? "";
    if (!isNonEmptyString(text)) {
      return NextResponse.json({ error: "Empty model response." }, { status: 500 });
    }

    let raw: any;
    try {
      raw = JSON.parse(text);
    } catch {
      // very small salvage: try to grab the first {...}
      const m = text.match(/\{[\s\S]*\}/);
      if (!m) throw new Error("Model returned non-JSON.");
      raw = JSON.parse(m[0]);
    }

    const pack = coercePack(raw, n);
    return NextResponse.json({ pack });
  } catch (err: any) {
    const msg = isNonEmptyString(err?.message) ? err.message : "Unknown error";
    return NextResponse.json({ error: msg }, { status: 500 });
  }
}
